<div id="RolePop" class="popup-max" style="width:100%;">
    <div class="popup list" style="width:90%; left:5%; margin-left:0;">
        <p name="RoleTitle">角色信息</p>
        <a class="popup-close" href="javascript:void(0);">关闭</a>
        <lable>
            <input type="hidden" name="ID" />
            <div class="user-detailsinformation">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td class="field">角色名称:</td>
                            <td><input name="txt_RoleNamePop" type="text" value="" /></td>
                            <td class="field">角色编码:</td>
                            <td><input name="txt_RoleCodePop" type="text" value="" /></td>
                        </tr>
                        <tr>
                            <td class="field">角色权限:</td>
                            <td colspan="3">
                                <div id="RoleConfigMenu" class="tab-pane in active" style="max-height:300px; overflow-x:auto; overflow-y:scroll;">
                                    <div id="tree"></div>

                                    <table id="treetable" class="table table-striped table-green">
                                        <thead>
                                            <tr>
                                                <th style="text-align:center; width:15%;">ID</th>
                                                <th style="text-align:left; width:85%; padding-left:30px;">
                                                    <span>名称</span>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="text-align:left"></td>
                                                <td style="text-align:left"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="user-detailsinformation-input">
                    <input class="btn-primary" @*data-toggle="modal" data-target="#myModal"*@ type="button" value="保存" onclick="RoleJS.Save();" />
                    <input class="btn-primary" type="button" value="退回" onclick="RoleJS.TurnBack();" />
                </div>
            </div>
        </lable>
    </div>
</div>
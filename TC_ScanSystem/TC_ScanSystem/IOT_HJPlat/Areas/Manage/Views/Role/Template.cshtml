<script type="text/html" id="RoleTemplate">
    <table class="table table-striped table-normal">
        <thead>
            <tr>
                <th hidden="hidden">ID</th>
                <th>角色名</th>
                <th>角色编码</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            {{if list.length>=0}}
            {{each list as Value}}
            <tr>
                <td hidden="hidden">{{Value.ID}}</td>
                <td>{{Value.RoleName}}</td>
                <td>{{Value.RoleCode}}</td>
                <td>
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" data-name="{{Value.RoleName}}" onclick='RoleJS.Edit(this)'>编辑</a>&nbsp;&nbsp;&nbsp;&nbsp;
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" data-name="{{Value.RoleName}}" onclick='RoleJS.Delete(this)'>删除</a>
                </td>
            </tr>
            {{/each}}
            {{/if}}
        </tbody>
    </table>

</script>

@*详情弹出框*@
<div id="AccountPopUp" class="popup-max" style="width:100%;">
    <div class="popup list" style="width:90%; left:5%; margin-left:0;">
        <p name="AccountTitle">新增用户</p>
        <a class="popup-close" href="javascript:void(0);">关闭</a>
        <lable>
            <input type="hidden" name="AccountID" />
            <input type="hidden" name="Type" />
            <div class="user-detailsinformation">
                <table class="table table-striped">
                    <tbody>
                        <tr>

                            <td class="field">用户名:</td>
                            <td><input name="txt_UserNamePop" type="text" value="" /></td>
                            <td class="field">登录密码:</td>
                            <td><input name="txt_PasswordPop" type="password" value="111111" /></td>
                        </tr>
                        <tr>
                            <td class="field">姓名:</td>
                            <td><input name="txt_RealNamePop" type="text" value="" /></td>
                            @*<td class="field">手机号码:</td>
                            <td><input name="txt_MobilePop" type="text" value="" /></td>*@
                        </tr>
                        <tr>
                            <td class="field">角色分配:</td>
                            <td colspan="3" class="multiselection">
                                <ul name="UL_RolePop">
                                    @{ 
                                        var Roles = ViewData["Roles"] as List<DataEntity.Base_Role>;
                                        if (Roles != null && Roles.Count > 0)
                                        {
                                            foreach (var role in Roles)
                                            {
                                                <li><input type="checkbox" value="@role.ID" /><a>@role.RoleName</a></li>
                                            }
                                        }
                                    }
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="user-detailsinformation-input">
                    <input class="btn-primary" @*data-toggle="modal" data-target="#myModal"*@ type="button" value="保存" onclick="AccountJS.Save();" />
                    <input class="btn-primary" type="button" value="退回" onclick="AccountJS.TurnBack();" />
                </div>
            </div>
        </lable>
    </div>
</div>

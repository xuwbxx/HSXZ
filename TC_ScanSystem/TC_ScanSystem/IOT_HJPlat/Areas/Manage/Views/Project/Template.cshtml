<script type="text/html" id="ProjectTemplate">
    <table class="table table-striped table-normal">
        <thead>
            <tr>
                <th>项目名称</th>
                <th>项目简称</th>
                <th>编号</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            {{if list.length>=0}}
            {{each list as Value}}
            <tr>
                <td>{{Value.ProjectName}}</td>
                <td>{{Value.ShortName}}</td>
                <td>{{Value.ProjectCode}}</td>
                <td>
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick='ProjectJS.Edit(this)'>编辑</a>
                </td>
            </tr>
            {{/each}}
            {{/if}}
        </tbody>
    </table>

</script>

<script type="text/html" id="DynamicTemplate">
    <div class="panel-body">
        <table class="table table-striped table-blue">
            <thead>
                <tr>
                    <th>监测点</th>
                    <th>位置</th>
                    @*<th>设备名</th>*@
                    <th>监测区域</th>
                    @*<th>监测类型</th>*@
                    <th>成果值</th>
                    <th>原始值</th>
                    <th>时间</th>
                </tr>
            </thead>
            <tbody>

                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.PointName}}</td>
                    <td>{{Value.PositionName}}</td>
                    @*<td>{{Value.DeviceName}}</td>*@
                    <td>{{Value.LayerName}}</td>
                    @*<td>{{Value.ScanTypeName}}</td>*@
                    <td>{{Value.ScanValue}}</td>
                    <td>{{Value.ScanValue2}}</td>
                    <td>{{Value.CreateTime}}</td>

                </tr>
                {{/each}}
                {{/if}}

            </tbody>
        </table>
    </div>
</script>
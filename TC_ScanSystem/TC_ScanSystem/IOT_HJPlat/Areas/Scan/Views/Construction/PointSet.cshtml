@{
    ViewBag.Title = "测点配置";
    Layout = "~/Views/Shared/IOTLayout.cshtml";
}

@{

    var Layers = ViewData["Layers"] as List<DataEntity.MK_Layer>;
    var ScanTypes = ViewData["ScanTypes"] as List<DataEntity.MK_ScanType>;
    var Postions = ViewData["Postions"] as List<DataEntity.MK_Position>;
    var Devices = ViewData["Devices"] as List<DataEntity.MK_Device>;
    var PositionImg = ViewData["PositionImg"].ToString();
    var PointList = ViewData["PointList"] as List<Model.HJPlat.Response.ConstructCfgPointResponse>;
}

<div class="content">
    <div class="col-lg-12">
        <input type="hidden" value="46" id="select">

        <ul id="myTab" class="nav nav-tabs">
            <li class="active">
                <a href="#" data-toggle="tab">监测区域</a>
            </li>

        </ul>

        <!--tab内容-->
        <div class="tab-content" id="myTabContent" style="min-height: 690px;">
            <!--车辆进出数据-->
            <div class="tab-pane fade in active" id="shuju">
                <!--筛选条件-->
                <ul class="mine-screen row-fluid">

                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">类型选择：</a>
                        <select id="SelScanTypePoint" name="SelScanTypePoint" onchange="PointSetJS.SelectChange2()">
                            <option value="0">全部</option>
                            @{
                                if (ScanTypes != null && ScanTypes.Count > 0)
                                {
                                    foreach (var item in ScanTypes)
                                    {
                                        <option value="@item.ID" data-icon="/Content/IOT/img/@item.ImagePath">@item.TypeName</option>
                                    }
                                }
                            }
                        </select>
                    </li>
                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">区域选择：</a>
                        <select id="PointSelectLayer" name="PointSelectLayer" onchange="PointSetJS.SelectChange1()">
                            <option value="0">全部</option>
                            @{
                                if (Layers != null && Layers.Count > 0)
                                {
                                    foreach (var item in Layers)
                                    {
                                        <option value="@item.ID">@item.LayerName</option>
                                    }
                                }
                            }
                        </select>
                    </li>
                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">监测位置：</a>
                        <select id="PointSelectPosition" name="PointSelectPosition">
                            <option value="0">全部</option>
                            @{
                                if (Postions != null && Postions.Count > 0)
                                {
                                    foreach (var item in Postions)
                                    {
                                        <option value="@item.ID">@item.PositionName</option>
                                    }
                                }
                            }
                        </select>
                    </li>
                    @*<li class="col-lg-2 col-md-6 col-sm-6 col-xs-12">
                       
                    </li>*@
                    
                    <li class="col-lg-4 col-md-6 col-sm-6 col-xs-12">
                        <input type="button" value="查询" onclick="PointSetJS.SelectChange()">
                        <input type="button" value="添加测点" onclick="PointSetJS.AddIcon()">
                        @*<input type="button" value="显示定位值" class="showposition" onClick="alert( positionleft +'+'+ positiontop)">*@
                    </li>
                </ul>
                <!--表-->
                <div class="yujing-bg col-lg-12 col-md-4 col-sm-6 col-xs-12" id="div_Icon">
                    @*<img src="~/Content/FD/bg/monitor2.jpg" ondragstart="return false;" />*@
                    @{
                        <img src="~/Upload/@PositionImg" ondragstart="return false;" id="imgback" />
                    }
                    @*<div class="tuli"></div>*@
                    <ul class="icon-yujing" id="UL_Icon">
                        @{
                            if (PointList != null && PointList.Count > 0)
                            {
                                foreach (var item in PointList)
                                {
                                    @*<li><a style="top: @item.MapYs; left: @item.MapXs;" title="@item.PointName" href="/Scan/Construction/CalIndex?ID=@item.ID">@item.PointName</a></li>*@
                                    <li data-id="@item.ID"  ondblclick="PointSetJS.ShowPointInfo(this)" onmousedown="    PointSetJS.IconEventMouseDown(this)" style="background-image: url('/Content/IOT/img/@item.ImagePath'); left: @item.MapXs; top: @item.MapYs;">@*<a title="@item.PointName" href="/Scan/Construction/CalIndex?ID=@item.ID"></a>*@</li>
                                }
                            }
                        }
                    </ul>
                </div>

                <div style="clear:both;"></div>

            </div>


            <!--趋势图-->

        </div>
    </div>
    <div style="clear:both;"></div>
    @*<script type="text/javascript" src="./苏州港太仓港区码头全寿命周期健康监测系统_files/Home_Layer.js.下载"></script>*@
</div>

@Html.Partial("PointSetPopUp")
<script type="text/javascript" src="~/Scripts/IOT/PointSet.js"></script>

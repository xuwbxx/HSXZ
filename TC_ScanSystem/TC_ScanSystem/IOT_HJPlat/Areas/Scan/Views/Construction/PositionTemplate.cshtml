<script type="text/html" id="PositionTemplate">
    <div class="panel-body">
        <table class="table table-striped table-red">
            <thead>
                <tr>
                    <th>监测位置</th>
                    <th>所属项目</th>
                    <th>监测区域</th>
                    <th>更新时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.PositionName}}</td>
                    <td>{{Value.ProjectName}}</td>
                    <td>{{Value.LayerName}}</td>
                    <td>{{Value.CreateTime}}</td>
                    <td>
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigPositionJS.ShowPositionInfo(this)">编辑</a>
                        /
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigPositionJS.DeletePosition(this)">删除</a>
                    </td>
                </tr>
                {{/each}}
                {{/if}}
            </tbody>
        </table>
    </div>
</script>

<script type="text/html" id="AlertTemplate">
    <div class="panel-body">
        <table class="table table-striped table-blue">
            <thead>
                <tr>
                    <th>监测点</th>
                    <th>位置</th>
                    <th>区域名</th>
                    @*<th>监测类型</th>*@
                    <th>监测值</th>
                    <th>报警值</th>
                    <th>时间</th>
                    <th>预警等级</th>
                </tr>
            </thead>
            <tbody>

                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.PointName}}</td>
                    <td>{{Value.PositionName}}</td>
                    <td>{{Value.LayerName}}</td>
                    @*<td>{{Value.ScanTypeName}}</td>*@
                    <td>{{Value.ScanValue}}</td>
                    <td>{{Value.ScanValue2}}</td>
                    <td>{{Value.CreateTime}}</td>
                    <td>{{Value.level}}</td>
                </tr>
                {{/each}}
                {{/if}}

            </tbody>
        </table>
    </div>
</script>
<script type="text/html" id="ScanTypeTemplate">
    <div class="panel-body">
        <table class="table table-striped table-red">
            <thead>
                <tr>
                    <th>监测内容</th>
                    <th>项目名称</th>
                    <th>协议</th>
                    <th>更新时间</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.TypeName}}</td>
                    <td>{{Value.ProjectName}}</td>
                    <td>{{Value.Protocol}}</td>
                    <td>{{Value.CreateTime}}</td>
                    <td>
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigScanTypeJS.ShowScanTypeInfo(this)">编辑</a>
                        /
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigScanTypeJS.DeleteScanType(this)">删除</a>
                    </td>
                </tr>
                {{/each}}
                {{/if}}
            </tbody>
        </table>
    </div>
</script>

@*详情弹出框*@
<div id="ScanTypePopUp" class="popup-max" style="width:100%;">
    <div class="popup list" style="width:90%; left:5%; margin-left:0;">
        <p name="ScanTypeInfoTitle">监测内容信息</p>
        <a class="popup-close" href="javascript:void(0);">关闭</a>
        <lable>
            <input type="hidden" name="ScanTypeIdx" />
            <input type="hidden" name="TypeScanType" />
            <div class="user-detailsinformation">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td class="field">内容名称:</td>
                            <td><input name="ScanTypeName" type="text" value="" /></td>
                            <td class="field">所属项目:</td>
                            <td>
                                <select name="ProjectSelectScanType">
                                    <option value="0">全部</option>
                                    @{
                                        var Projects = ViewData["Projects"] as List<DataEntity.Base_Project>;
                                        if (Projects != null && Projects.Count > 0)
                                        {
                                            foreach (var item in Projects)
                                            {
                                                <option value="@item.ID">@item.ProjectName</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="field">协议:</td>
                            <td>
                                <select name="ProtocolSelectScanType">
                                    <option value="0">全部</option>
                                    @{
                                        var Protocols = ViewData["Protocols"] as List<DataEntity.MK_Protocol>;
                                        if (Protocols != null && Protocols.Count > 0)
                                        {
                                            foreach (var item in Protocols)
                                            {
                                                <option value="@item.ID">@item.Protocol</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td class="field">备注：</td>
                            <td>
                                <input name="DescriptionScanType" type="text" value="" />
                            </td>
                        </tr>
                        <tr>
                           
                            <td class="field">文件名称：</td>
                            <td>
                                <input name="ImagePath" type="text" value="" />
                            </td>
                            <td class="field"></td>
                            <td>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="user-detailsinformation-input">
                    <input class="btn-primary" @*data-toggle="modal" data-target="#myModal"*@ type="button" value="保存" onclick="ConstructConfigScanTypeJS.ShowModal();" />
                    <input class="btn-primary" type="button" value="退回" onclick="ConstructConfigScanTypeJS.TurnBack();" />
                </div>
            </div>
        </lable>
    </div>
</div>

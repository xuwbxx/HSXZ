<script type="text/html" id="PointTemplate">
    <div class="panel-body">
        <table class="table table-striped table-red">
            <thead>
                <tr>
                    <th>测点名称</th>
                    <th>关键字1</th>
                    <th>关键字2</th>
                    <th>所属项目</th>
                    <th>测点位置</th>
                    <th>标高</th>
                    <th>设备名称</th>
                    <th>传感器编号</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.PointName}}</td>
                    <td>{{Value.MapDataName}}</td>
                    <td>{{Value.MapDataName2}}</td>
                    <td>{{Value.ProjectName}}</td>
                    <td>{{Value.PositionName}}</td>
                    <td>{{Value.Height}}</td>
                    <td>{{Value.DeviceName}}</td>
                    <td>{{Value.pName}}</td>
                    <td>
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigPointJS.ShowPointInfo(this)">编辑</a>
                        /
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="ConstructConfigPointJS.DeletePoint(this)">删除</a>
                    </td>
                </tr>
                {{/each}}
                {{/if}}
            </tbody>
        </table>
    </div>
</script>

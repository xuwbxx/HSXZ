@{
    ViewBag.Title = "测点管理";
    Layout = "~/Views/Shared/IOTLayout.cshtml";
}

@{
    var DeviceList = ViewData["Devices"] as List<DataEntity.MK_Device>;

}

<div class="content">
    <div class="col-lg-12">

        <ul id="myTab" class="nav nav-tabs">
            <li class="active">
                <a href="#shuju" data-toggle="tab">设备设置</a>
            </li>
        </ul>

        <!--tab内容-->
        <div class="tab-content" ">
            <div class="tab-pane fade in active">
                <!--筛选条件-->
                <ul class="mine-screen row-fluid">
                    <li class="form-group col-lg-12 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">监测设备选择</a>
                        <select style="width:300px;" id="select_AutoDevice" onchange="ConstructAutoCommandJS.SelectChange('device');">
                            <option value="0">请选择</option>
                            @{
                                if (DeviceList != null && DeviceList.Count > 0)
                                {
                                    foreach (var item in DeviceList)
                                    {
                                        <option value="@item.ID">@item.DeviceName</option>
                                    }
                                }
                            }
                        </select>
                    </li>
                    <li class="form-group col-lg-9 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">采集频率:次</a>
                        <input placeholder="请输入天数" style="width:150px;" name="txtDate" id="txtDate" type="text" value="" /><a class="screen-a">天</a>
                        <input placeholder="请输入小时" style="width:150px;" name="txtHour" id="txtHour" type="text" value="" /><a class="screen-a">
    时</a>
   <input placeholder="请输入分钟" style="width:150px;" name="txtMin" id="txtMin" type="text" value="" /><a class="screen-a">分</a>
</li>

                    <li class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <input type="button" value="采样频率设置" onclick="ConstructAutoCommandJS.SaveInterval()" />
                        @*<input type="button" value="重置查询" />*@
                    </li>
                    <li class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12">
                        <label for="dtp_input11" class="col-md-5 control-label">模块时间：</label>
                       
                         <div class="input-group date form_datetime col-lg-2" data-date="1979-09-16T05:25:07Z" data-date-format="yyyy-mm-dd hh:ii p" data-link-field="dtp_input11">
                            <input name="DeviceDate" class="form-control" type="text" value="" readonly style="width:100%;">
                            <span class="input-group-addon"><span class="glyphicon glyphicon-remove"></span></span>
                            <span class="input-group-addon"><span class="glyphicon glyphicon-th"></span></span>
                        </div>
                        <input type="hidden" id="dtp_input11" name="AcquisitionBeginDate" value="" /><br />
                    </li>

                    <li class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <input type="button" value="采样频率设置" onclick="ConstructAutoCommandJS.SaveDeviceTime()" />
                        @*<input type="button" value="重置查询" />*@
                    </li>
                    <li class="form-group col-lg-9 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">起始时间：</a>
                        <input placeholder="请输入起始时间" style="width:300px;" name="txtBeginTime" id="txtBeginTime" type="text" value="" />
                    </li>

                    <li class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <input type="button" value="起始时间设置" onclick="ConstructAutoCommandJS.SaveBeginTime()" />
                        @*<input type="button" value="重置查询" />*@
                    </li>
                    <li class="form-group col-lg-9 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">输入指令：</a>
                        <input placeholder="请输入指令" style="width:450px;" name="txtCommand" id="txtCommand" type="text" value="" />
                    </li>

                    <li class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <input type="button" value="发动指令" onclick="ConstructAutoCommandJS.Send()" />
                        @*<input type="button" value="重置查询" />*@
                    </li>
                </ul>
               
            </div>
            </div></div>
    <div style="clear:both;"></div>
        </div>

            <script type="text/javascript" src="~/Scripts/IOT/Command.js"></script>

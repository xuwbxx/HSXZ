<script type="text/html" id="DeviceTemplate">
    <div class="panel-body">
        <table class="table table-striped table-red">
            <thead>
                <tr>
                    <th>监测区域</th>
                    <th>监测设备</th>
                    <th>设备编号</th>
                    <th>设备传输协议</th>
                    <th>通讯设备名称</th>
                    <th>创建时间</th>
                    <th>连接情况</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.LayerName}}</td>
                    <td>{{Value.DeviceName}}</td>
                    <td>{{Value.DeviceIden}}</td>
                    <td>{{Value.DeviceProtocolName}}</td>
                    <td>{{Value.CommunicationName}}</td>
                    <td>{{Value.CreateTime}}</td>
                    <td>{{Value.StatusName}}</td>
                    <td>
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="DeviceJS.ShowDeviceInfo(this)">编辑</a>
                        /
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="DeviceJS.DeleteDevice(this)">删除</a>
                    </td>
                </tr>
                {{/each}}
                {{/if}}
            </tbody>
        </table>
    </div>
</script>

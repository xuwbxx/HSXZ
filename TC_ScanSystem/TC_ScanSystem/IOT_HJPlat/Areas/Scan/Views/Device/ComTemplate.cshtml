<script type="text/html" id="ComTemplate">
    <div class="panel-body">
        <table class="table table-striped table-red">
            <thead>
                <tr>
                    <th>通讯设备名称</th>
                    <th>通讯设备类型</th>
                    <th>通讯协议</th>
                    <th>通讯类型</th>
                    <th>所属项目</th>
                    <th>IP地址</th>
                    <th>端口号</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{if list.length>=0}}
                {{each list as Value}}
                <tr>
                    <td>{{Value.CommunicationName}}</td>
                    <td>{{Value.DeviceTypeName}}</td>
                    <td>{{Value.DataProtocolName}}</td>
                    <td>{{Value.CommunicationTypeName}}</td>
                    <td>{{Value.ProjectName}}</td>
                    <td>{{Value.IP}}</td>
                    <td>{{Value.Port}}</td>
                    <td>
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="CommunicationJS.ShowComInfo(this)">编辑</a>
                        /
                        <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="CommunicationJS.DeleteCom(this)">删除</a>
                    </td>
                </tr>
                {{/each}}
                {{/if}}
            </tbody>
        </table>
    </div>
</script>
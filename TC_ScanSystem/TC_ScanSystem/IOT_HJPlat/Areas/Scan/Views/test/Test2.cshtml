    //初始数据库搜索并加载
    var DataQuery = function () {
        $.post('DataQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        $("#UL_Icon").empty();

                        var Ul_Html = '';
                        $(data.Data).each(function () {

                            //类型，就是下拉框的图片
                            var SelectType = '';

                            //位置
                            var X = '0';
                            var Y = '0';

                            Ul_Html += '<li style="background-image:url(../../../../Content/FD/icon-yujing/' + SelectType + '); left:' + X + '%; top:' + Y + '%" onmousedown="IconEventMouseDown(this)"></li>';
                        })

                        $("#UL_Icon").html(Ul_Html);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {

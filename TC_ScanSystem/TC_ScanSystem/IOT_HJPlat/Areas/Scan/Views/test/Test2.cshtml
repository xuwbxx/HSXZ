    var OriginX = '';
    var OriginY = '';

    $(document).ready(function () {

        var Origin = $("div#div_Icon").offset();
        OriginX = Origin.left;
        OriginY = Origin.top;

    })

    var _move = false;

    var IconEventMouseDown = function (e) {

        _move = true;

        var Icon = e;

        $(document).mousemove(function (dom) {

            if (!_move)
            {
                return false;
            }

            var x = dom.pageX - OriginX - 10;
            var y = dom.pageY - OriginY - 10;

            var DivWidth = $('.yujing-bg').width();
            var DivHeight = $('.yujing-bg').height();

            if (x <= 0) {
                x = 0;
            }
            else if (x >= DivWidth)
            {
                x = DivWidth;
            }

            if (y <= 0) {
                y = 0;
            }
            else if (y >= DivHeight)
            {
                y = DivHeight;
            }
            
            var xLeft = x / DivWidth;
            var xTop = y / DivHeight;

            $(Icon).css({
                'left': 100 * xLeft + '%',
                'top': 100 * xTop + '%'
            });

        }).mouseup(function () {
            _move = false;
            $(document).off('mousemove');
        })

        //$(e).mouseup(function () {

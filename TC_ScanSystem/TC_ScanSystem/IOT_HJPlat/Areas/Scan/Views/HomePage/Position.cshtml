@{
    ViewBag.Title = "监测位置";
    Layout = "~/Views/Shared/IOTLayout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Content/IOT/css/bootstrap-select.min.css" />
<script type="text/javascript" src="~/Content/IOT/js/bootstrap-select.min.js"></script>

@{
    var PositionList = ViewData["PositionList"] as List<DataEntity.MK_Position>;
    var PositionImg = ViewData["PositionImg"].ToString();
    var PointList = ViewData["PointList"] as List<Model.HJPlat.Response.ConstructCfgPointResponse>;
    //var ScanTypeList = ViewData["ScanTypeList"] as List<DataEntity.MK_ScanType>;
}
<script type="text/javascript">
    $(document).ready(function () {
        //do something
        $("select[name='select_AutoPosition'] option[value='" + $("#select").val() + "']").prop('selected', true);
    })

    $('.content-max').width(document.body.scrollWidth - 201);
    // content限制高度
    $('.content-min').css({ 'min-height': window.innerHeight - 140 + 'px' });
    $('.tab-content').css({ 'min-height': window.innerHeight - 182 + 'px' });
    $('.choice').css({ 'min-height': window.innerHeight - 120 + 'px' });
</script>

<div class="content">
    <div class="col-lg-12">
        @{
            var ID = Request.QueryString["ID"];
            <input type="hidden" value="@ID" id="select" />
        }
        <ul id="myTab" class="nav nav-tabs">
            <li class="active">
                <a href="#shuju" data-toggle="tab">监测位置</a>
            </li>
            @*<li>
                    <a href="#qushi" data-toggle="tab">趋势图</a>
                </li>*@
        </ul>

        <!--tab内容-->
        <div class="tab-content" id="myTabContent">
            <!--车辆进出数据-->
            <div class="tab-pane fade in active" id="shuju">
                <!--筛选条件-->
                <ul class="mine-screen row-fluid">

                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">监测位置：</a>
                        <select id="select_AutoPosition" name="select_AutoPosition">
                            @*<option value="0">请选择</option>*@
                            @{
                                if (PositionList != null && PositionList.Count > 0)
                                {
                                    foreach (var item in PositionList)
                                    {
                                        <option value="@item.ID">@item.PositionName</option>
                                    }
                                }
                            }
                        </select>
                    </li>
                    <li class="col-lg-5 col-md-6 col-sm-6 col-xs-12">
                        <input type="button" value="查询" onclick="PositionJS.SelectChange()" />

                    </li>
                </ul>
                <!--表-->
                <div class="yujing-bg col-lg-12 col-md-4 col-sm-6 col-xs-12">
                    @{
                        <img src="~/Upload/@PositionImg" id="imgback" />
                    }
                    <div class="tuli"></div>
                    <ul class="icon-yujing" id="imglist">
                        @{
                            if (PointList != null && PointList.Count > 0)
                            {
                                foreach (var item in PointList)
                                {
                                    @*<li><a style="top: @item.MapYs; left: @item.MapXs;" title="@item.PointName" href="/Scan/Construction/CalIndex?ID=@item.ID">@item.PointName</a></li>*@
                                    <li style="background-image: url('/Content/IOT/img/@item.ImagePath'); left: @item.MapXs; top: @item.MapYs;"><a title="@item.PointName" href="@item.Url" style="display:block;width:22px;height:22px;"></a></li>
                                }
                            }
                        }
                        </ul>
                        @*<ul class="mapp-icon1" id="imglist">
                            @{
                                if (PointList != null && PointList.Count > 0)
                                {
                                    foreach (var item in PointList)
                                    {
                                        <li><a style="top: @item.MapYs; left: @item.MapXs;" title="@item.PointName" href="/Scan/Construction/CalIndex?ID=@item.ID">@item.PointName</a></li>
                                    }
                                }
                            }
                        </ul>*@
</div>
                <div style="clear:both;"></div>

            </div>


            <!--趋势图-->
            @*<div class="tab-pane fade" id="qushi">

                </div>*@
        </div>
    </div>
    <div style="clear:both;"></div>
    <script type="text/javascript" src="~/Scripts/IOT/Home_Position.js"></script>
</div>


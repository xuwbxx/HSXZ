    var DatTimeTransfer = function (time) {
        var date = new Date(time)
        var year = date.getFullYear();
        var month = date.getMonth() + 1;
        var day = date.getDate();
        var hour = date.getHours();
        var minute = date.getMinutes();
        var second = date.getSeconds();
        return formatTen(hour) + ":" + formatTen(minute) + ":" + formatTen(second);
        //return year + "-" + formatTen(month) + "-" + formatTen(day) + " " + formatTen(hour) + ":" + formatTen(minute) + ":" + formatTen(second);
    }

    var DatTimeTransfer1 = function () {
        var date = new Date()
        var year = date.getFullYear();
        var month = date.getMonth() + 1;
        var day = date.getDate();
        //var hour = date.getHours();
        //var minute = date.getMinutes();
        //var second = date.getSeconds();
        //return formatTen(hour) + ":" + formatTen(minute) + ":" + formatTen(second);
        return year + "-" + formatTen(month) + "-" + formatTen(day);
    }

    var DatTimeTransfer2 = function () {
        var date = new Date()
        var year = date.getFullYear();
        var month = date.getMonth() + 1;
        var day = date.getDate()+1;
        //var hour = date.getHours();
        //var minute = date.getMinutes();
        //var second = date.getSeconds();
        //return formatTen(hour) + ":" + formatTen(minute) + ":" + formatTen(second);
        return year + "-" + formatTen(month) + "-" + formatTen(day);
    }

    function formatTen(num) {
        return num > 9 ? (num + "") : ("0" + num);
    }



    //测点动态查询
    var QueryParam = {};

    var ParamInit = function () {

        QueryParam.PageIndex = 1;
        QueryParam.PageSize = 10;
        QueryParam.TotalPage = 0;
        QueryParam.TotalCount = 0;

    }

    var PointTimeQuery = function (temp) {
        QueryParam.StartTime = $('#Point_date_start').val();
        QueryParam.EndTime = $('#Point_date_end').val();
        QueryParam.MonitorPointID = $('#PointId').val();

        //测点数据
        //$('#table_MonitorPointValue').html('');
        //echart
        if (detChart != null && temp==0) {
            detChart.clear();
        }


        $.post('getMonitorPointData', QueryParam)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                        var html = '';
                        $("#value1").html(data.title1);
                        $("#value2").html(data.title2);
                        var count = 1;
                        $(data.Data).each(function (index, dom) {
                            var AlarmHtml;
                            if (dom.IsAlarm) {
                                AlarmHtml = 'style="color: red;"';
                            }
                            html += '<tr><td>' + count + '</td><td ' + AlarmHtml + '>' + Number(dom.Value1).toFixed(3) + '</td><td>' + dom.CreateTime + '</td></tr>';
                            count++;

                        })

                        //测点数据
                        $('#table_MonitorPointValue').html(html);


                        //分页
                        QueryParam.TotalPage = data.TotalPage;
                        QueryParam.TotalCount = data.TotalCount;
                        QueryParam.PageIndex = data.PageIndex;

                        if(temp==0)
                        EchartsInit(data.Echart,data.Url);
                        //Echats
                        

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {

            })
            .always(function (data) {
                Pagination();
            });
    }

    var Pagination = function () {
        $("#Pagination").pagination({
            currentPage: QueryParam.PageIndex,
            totalPage: QueryParam.TotalPage,
            isShow: true,
            totalCount: QueryParam.TotalCount,
            count: 7,
            homePageText: "首页",
            endPageText: "尾页",
            prevPageText: "上一页",
            nextPageText: "下一页",
            callback: function (current) {
                QueryParam.PageIndex = current;
                PointTimeQuery(1);
            }
        });
    }


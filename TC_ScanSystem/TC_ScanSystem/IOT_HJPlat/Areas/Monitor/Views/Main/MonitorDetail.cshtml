        //minView: "month",//设置只显示到月份
       // format: 'yyyy-mm-dd',//显示格式
        todayBtn: 1,
        autoclose: 1,
        todayHighlight: 1,
        startView: 2,
        forceParse: 0,
        showMeridian: 1
    });

    //拖拽
    $('.popup').children('.popuptitle').children('p').mousedown(function(e) {
        var positionleft = '';
        var positiontop = '';
        var positionDiv = $(this).parent().parent().offset();
        var distenceX = e.pageX - positionDiv.left; //鼠标距离元素左上角X距离
        var distenceY = e.pageY - positionDiv.top; //鼠标距离元素左上角Y距离
        var that = $(this).parent().parent();
	
        $(document).mousemove(function(e) {
            var x = e.pageX - distenceX;
            var y = e.pageY - distenceY;
		
            if (x < 0) {
                x = 0;
            } else if (x > $('body').get(0).offsetWidth-$(that).get(0).offsetWidth) {
                x = $('body').get(0).offsetWidth-$(that).get(0).offsetWidth;
            }

            if (y < 0) {
                y = 0;
            } else if (y > $('.bg').get(0).offsetHeight- $(that).get(0).offsetHeight) {
                y = $('.bg').get(0).offsetHeight - $(that).get(0).offsetHeight;
            }
		
            var xLeft = x/$('body').get(0).offsetWidth;
            var xTop = y/$('body').get(0).offsetHeight;
		
            $(that).css({
                'left': 100*xLeft + '%',
                'top': 100*xTop + '%'
            });
		
            positionleft = 100*xLeft + '%';
            positiontop = 100*xTop + '%';
        });
        $(document).mouseup(function() {
            $(document).off('mousemove');
        });
	
    });

    </script>


<div class="bg">
    <img src="~/Content/New/img/太仓码头.png" />
    @*<canvas id="container" style="cursor:default;background:url(/Content/New/img/太仓码头.jpg);width:100%;height:100%;"></canvas>*@
    <ul class="pointul"></ul>
</div>

<div class="typeswitch">
    <div class="button">
        <a class="change">
            <div></div>
            <p>传感器类型/位置</p>
        </a>
        @*<a class="warning" onclick="OpenMonitorAlarm()">
                <div></div>
                <p>预警中心</p>
            </a>*@
    </div>
    <ul class="changeul">
        @{
            if (MonitorTypes != null && MonitorTypes != null)
            {
                foreach (var item in MonitorTypes)
                {
                    <li data-id="@item.ID" data-name="@item.MonitorName" class="@item.IconClass" onclick="ChangeMonitorType(this)">
                        <div></div>
                        <p>@item.MonitorName</p>
                    </li>
                }
            }
        }

    </ul>
</div>

<script>
    $('div#div_Setting').click(function () {
        window.location.href = '/Scan/Construction/DynamicIndex';
    });
    $('div#div_LogOut').click(function () {
        window.location.href = '/Home/LogOut';
    });

    $(document).ready(function () {

        getThisWeather();

        ChangeMonitorType();

       // init();
       // InitView(20, -14, 33);
        //animate();
      //  DisplayAlarmArea();
    })


    //类型切换
    var onoff = true;
    $('.change').click(function () {
        if (onoff) {
            $('.changeul').fadeIn();
            //$('.bg').children('img').attr("src","../../Content/New/img/bg.png");
            //$('.pointul').fadeIn(500);
            //$('.popup').fadeOut();
            onoff = false;



        } else {
            $('.changeul').fadeOut();
            onoff = true;
        }
    })

    //热点悬浮
    $('.pointul li ul li').children('div').hover(function () {
        $(this).parent('li').css({ "z-index": "8" })
    }, function () {
        $(this).parent('li').css({ "z-index": "5" })
    })
    //弹窗关闭
    $('.monitarea>div').children('.popclose').click(function () {
        $('.popup').fadeOut();
    })
    $('.monitdate>div').children('.popclose').click(function () {
        $(this).parent('.popuptitle').parent('.popup').fadeOut();
    })
    //数据弹窗打开
    $('.monitdateopen').click(function () {
        $('.monitdate').fadeIn();
    })


    //获取时间
    function getThisDate() {
        //获取当前时间
        var date = new Date();
        //格式化为本地时间格式
        var date1 = date.toLocaleString();
        $('#div_Time').html(date1);
    }
    //使用定时器每秒向div写入当前时间
    setInterval("getThisDate()", 1000);

    //获取天气
    function getThisWeather() {

        $.post('GetWeather', '')
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var WeatherHtml = '';
                        WeatherHtml += data.Point + ' ' + data.Weather + ' ' + data.MinTemp + '-' + data.MaxTemp + '℃';
                        $('#div_Weather').html(WeatherHtml);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                $('#div_Weather').html('');
            })
            .always(function (data) {
            });
    }

    //切换监测类型
    function ChangeMonitorType(dom) {
        $('ul.pointul').html('');
        var ID;
        if (dom == null) {
            var MonitorTypeID = $('#hid_MonitorTypeID').val();
            ID = MonitorTypeID;
        }
        else {
            ID = $(dom).attr('data-id');
            var MonitorName = $(dom).attr('data-name');
            //$('div.state').html(MonitorName);
        }

        if (ID == null || ID == 0)
            return;

        var Param = {};
        
        Param.MonitorTypeID = ID;
       // init();
        $.post('getMonitorLayers', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                       // pointObjs = new Array();
                       
                        //$(data.Data).each(function (index, dom) {
                        //    //dom.method = "ChangeMonitorArea";
                        //    //dom.params = "MonitorAreaID";
                        //    if (dom.NewMapX && dom.NewMapY && dom.NewMapZ) {

                        //        if (index === 0) {
                        //            //InitView(dom.NewMapX - 60, dom.NewMapY - 5, dom.NewMapZ - 0);
                        //         //   InitView(15, -20, 40);
                        //        }
                        //       // SetClickEnable(true);
                        //       // CreatePoint(dom);
                        //    }
                        //   // CreatePoint(dom);
                        //});


                        var html = '<li class=""><ul>';
                        $(data.Data).each(function (index, dom) {
                            //html += '<li onclick="ChangeMonitorArea(' + dom.MonitorAreaID + ')" style="left:' + dom.X + '%; top:' + dom.Y + '%;"><p>' + dom.MonitorAreaName + '</p><div class="' + (dom.IsAlarm ? 'point2' : 'point1') + '"></div></li>';
                            html += '<li onclick="ChangeMonitorArea(' + dom.MonitorAreaID + ')" style="left:' + dom.X + '%; top:' + dom.Y + '%;"><p>' + dom.MonitorAreaName + '</p><div class="' + dom.IconClass +'"></div></li>';

                        });
                        html += '</ul></li>';
                        $('ul.pointul').html('');
                        $('ul.pointul').html(html);

                        //$(testData).each(function (index, dom) {
                        //    CreatePoint(dom);
                        //});
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                $('#div_Weather').html('');
            })
            .always(function (data) {
            });
    }

    var testData = [
        { ID: 1, IconClass: "point1", IsAlarm: false, IsCommand: 3, MonitorAreaName: "126排", MonitorTypeID: 1, MonitorTypeName: "PHC管桩传感器", X: "-16.5", Y: "45" },
        { ID: 2, IconClass: "point1", IsAlarm: false, IsCommand: 3, MonitorAreaName: "128排", MonitorTypeID: 1, MonitorTypeName: "PHC管桩传感器", X: "1.5", Y: "40" },
        { ID: 3, IconClass: "point1", IsAlarm: false, IsCommand: 3, MonitorAreaName: "130排", MonitorTypeID: 1, MonitorTypeName: "PHC管桩传感器", X: "20", Y: "33" },
        { ID: 4, IconClass: "point1", IsAlarm: false, IsCommand: 3, MonitorAreaName: "132排", MonitorTypeID: 1, MonitorTypeName: "PHC管桩传感器", X: "40", Y: "28" },
        { ID: 5, IconClass: "point1", IsAlarm: false, IsCommand: 3, MonitorAreaName: "134排", MonitorTypeID: 1, MonitorTypeName: "PHC管桩传感器", X: "58", Y: "21" }
    ]

    function ChangeMonitorArea(Name) {

        if (Name == null || Name == '')
            return;
        window.open('MonitorDetail?MonitorAreaID=' + Name);
        //window.location.href = 'MonitorDetail?MonitorAreaID=' + ID
    }

    var OpenMonitorAlarm = function () {
        DisplayAlarmArea();
    }

    function DisplayAlarmArea() {

        $('ul.pointul').html('');

        var Param = {};
        $.post('getMonitorAreaAlarm', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var html = '<li class=""><ul>';
                        $(data.Data).each(function (index, dom) {
                            var AlarmClass = dom.IsAlarm ? 'point2' : 'point1';

                            html += '<li onclick="ChangeMonitorArea(' + dom.ID + ')" style="left:' + dom.X + '%; top:' + dom.Y + '%;"><p>' + dom.MonitorAreaName + '</p>' +
                                '<div class="' + AlarmClass + '"></div></li>';
                        });
                        html += '</ul></li>';
                        $('ul.pointul').html(html);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
            })
            .always(function (data) {
            });
    }

</script>


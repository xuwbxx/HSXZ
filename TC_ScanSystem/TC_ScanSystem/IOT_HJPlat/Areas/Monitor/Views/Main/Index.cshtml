    string ZL7 = ViewData["7ZL"].ToString();
    string ZL47 = ViewData["47ZL"].ToString();
    string HL7 = ViewData["7HL"].ToString();
    string HL47 = ViewData["47HL"].ToString();
    string PHC7_img = ViewData["7PHC_Img"].ToString();
    string PHC47_img = ViewData["47PHC_Img"].ToString();
    string ZL7_img = ViewData["7ZL_Img"].ToString();
    string ZL47_img = ViewData["47ZL_Img"].ToString();
    string HL7_img = ViewData["7HL_Img"].ToString();
    string HL47_img = ViewData["47HL_Img"].ToString();
}

<input id="hid_MonitorTypeID" type="hidden" value="@ViewData["MonitorTypeID"].ToString()" />
<input id="hid_BackGroundPic" type="hidden" value="../../Content/New/img/太仓码头.jpg" />
<input id="hid_isClick" type="hidden" value="true" />


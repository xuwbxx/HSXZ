<div class="head">
    <div><a href="/Main/HomePage"><img src="~/Content/Board/img/back.png" /></a></div>
    <p>高桩码头监测平台</p>
    <div>
        <p id="p_Time">@(DateTime.Now.ToString("yyyy年MM月dd日"))</p>
        @{
            var weather = Model as Model.Other.WeatherResponse;
            if (weather.Success)
            {
                <p>@weather.Point @weather.Weather @weather.MinTemp-@(weather.MaxTemp)℃</p>
            }
            else
            {
                <p>暂无天气数据</p>
            }
        }
        
    </div>
</div>


                var GetWarningLevelPercent = function(min, max, valueY, valueR) {
                    var ret = {};
                    ret.perY = 1;
                    ret.perR = 1;
                    var range = max - min;
                    // Number.isFinite(range);

                    if (range === 0) {
                        return ret;
                    }
                    else if (range < 0) {
                        range = -range;
                    }

                    if (IsNum(valueY)) {
                        var y = (valueY - min)/range;
                        if (0 < y <= 1) {
                            ret.perY = y;
                        }
                    }

                    if (IsNum(valueR)) {
                        var r = (valueR - min)/range;
                        if (0 < r <= 1) {
                            ret.perR = r;
                        }
                    }
                    if(ret.perY > ret.perR)
                    {
                        ret.perY = ret.perR;
                    }
                    return ret;
                }


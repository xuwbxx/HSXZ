<script type="text/javascript">
    $(document).ready(function () {
        SummaryQuery();

        function SummaryQuery() {
            var param = {};
            // param.PointID = $("#select_Point").val();

            $(".cumulative").addClass("mainmask");

            $.post('/Main/Board/GetSummary', param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            var str = "";
                            $(".cumulative ul").each(function (index, dom) {
                                var obj = data.Data;
                                obj.Item.forEach(function (elem, ind) {
                                    str += "<li><p>" + elem.Name + "(" + elem.Unit + ")</p><div><a>" + elem.Value + "</a></div></li>";
                                })
                                $(dom).html(str);
                            });
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                })
                .always(function (data) {
                    // 关闭等待遮罩
                    //CloseMaskPopUp();
                    $(".cumulative").removeClass("mainmask");
                });
        }
    });
</script>
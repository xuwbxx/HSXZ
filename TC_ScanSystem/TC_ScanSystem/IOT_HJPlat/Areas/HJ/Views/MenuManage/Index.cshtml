@{
    ViewBag.Title = "菜单管理";
    Layout = "~/Views/Shared/IOTLayout.cshtml";
}

<div class="content">
    <div class="content-min col-lg-12">
        <ul id="myTab" class="nav nav-tabs">
            <li class="active">
                <a href="#menu" data-toggle="tab">菜单数据</a>
            </li>
            @*<li>
                    <a href="#qushi" data-toggle="tab">趋势图</a>
                </li>*@
        </ul>
        <!--tab内容-->
        <div class="tab-content" id="myTabContent">
            <!--车辆进出实时数据-->
            <div class="tab-pane fade in active" id="menu">
                <!--筛选条件-->
                <ul class="mine-screen row-fluid">
                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">功能名称：</a>
                        <input type="text" name="txt_MenuName" value="" />
                    </li>
                    <li class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                        <a class="screen-a">功能编码：</a>
                        <input type="text" name="txt_FunctionCode" value="" />
                    </li>
                    <li class="col-lg-2 col-md-4 col-sm-6 col-xs-12">
                        <input class="btn btn-primary" type="button" value="查询" onclick="MenuJS.DoQuery()" />
                        <!--<input type="button" value="重置查询"/>-->
                    </li>
                    <li class="col-lg-2 col-md-4 col-sm-6 col-xs-12">
                        <input type="button" value="新增菜单" onclick="MenuJS.Add()" />
                        @*<input type="button" value="重置查询" />*@
                    </li>
                </ul>
                <!--表-->
                <div id="MenuHtml">
                </div>

                <!--翻页-->
                <div class="change-page" style="height:34px;">
                    <div id="Pagination">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@Html.Partial("MenuPop")
@Html.Partial("Template")

<script type="text/javascript" src="~/Scripts/Manage/MenuJS.js"></script>

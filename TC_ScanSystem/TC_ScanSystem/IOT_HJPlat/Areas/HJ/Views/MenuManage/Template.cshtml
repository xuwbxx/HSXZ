<script type="text/html" id="MenuHtmlTemplate">
    <table class="table table-striped table-normal">
        <thead>
            <tr>
                <th>菜单名称</th>
                <th>菜单编码</th>
                <th>菜单路径</th>
                <th>菜单样式</th>
                <th>排序</th>
                @*<th>职位</th>*@
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            {{if list.length>=0}}
            {{each list as Value}}
            <tr>
                <td>{{Value.MenuName}}</td>
               <td>{{Value.FunctionCode}}</td>
                <td>{{Value.Path}}</td>
                <td>{{Value.Class}}</td>
                <td>{{Value.Order}}</td>
                @*<td>{{Value.PositionName}}</td>*@
                <td>
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="MenuJS.Edit(this)">编辑</a>&nbsp;&nbsp;&nbsp;&nbsp;
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" data-name="{{Value.MenuName}}" onclick="MenuJS.Delete(this)">删除</a>
                </td>
            </tr>
            {{/each}}
            {{/if}}
        </tbody>
    </table>
</script>

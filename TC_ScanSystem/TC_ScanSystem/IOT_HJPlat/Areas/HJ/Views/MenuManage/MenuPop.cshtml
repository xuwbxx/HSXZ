                </table>
                <div class="user-detailsinformation-input">
                    <input class="btn-primary" @*data-toggle="modal" data-target="#myModal"*@ type="button" value="保存" onclick="MenuJS.Save();" />
                    <input class="btn-primary" type="button" value="退回" onclick="MenuJS.TurnBack();" />
                </div>
            </div>

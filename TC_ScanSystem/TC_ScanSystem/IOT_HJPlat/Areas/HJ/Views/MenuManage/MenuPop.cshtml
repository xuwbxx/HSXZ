@*详情弹出框*@
<div id="MenuPopUp" class="popup-max" style="width:100%;">
    <div class="popup list" style="width:90%; left:5%; margin-left:0;">
        <p name="MenuTitle">新增菜单</p>
        <a class="popup-close" href="javascript:void(0);">关闭</a>
        <lable>
            <input type="hidden" name="MenuID" />
            <input type="hidden" name="MenuType" />
            <div class="user-detailsinformation">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            @*<td rowspan="6" class="user-picture">
                                <div>
                                    <img src="~/Content/IOT/img/user-pic.png" />
                                </div>
                            </td>*@
                            <td class="field">菜单名称:</td>
                            <td><input name="txt_MenuNamePop" type="text" value="" /></td>
                            <td class="field">菜单编码:</td>
                            <td><input name="txt_FunctionCodePop" type="text" value="" /></td>
                        </tr>
                        <tr>
                            <td class="field">菜单路径:</td>
                            <td><input name="txt_PathPop" type="text" value="" /></td>
                            <td class="field">菜单样式:</td>
                            <td><input name="txt_ClassPop" type="text" value="" /></td>
                        </tr>
                        <tr>
                            <td class="field">排序:</td>
                            <td><input name="txt_OrderPop" type="text" value="" /></td>
                            <td class="field"></td>
                            <td></td>
                        </tr>

<script type="text/html" id="RoleHtmlTemplate">
    <table class="table table-striped table-normal">
        <thead>
            <tr>
                <th>角色名称</th>
                <th>角色编码</th>
                @*<th>职位</th>*@
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            {{if list.length>=0}}
            {{each list as Value}}
            <tr>
                <td>{{Value.RoleName}}</td>
                <td>{{Value.RoleCode}}</td>

                <td>
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="RoleJS.Edit(this)">编辑</a>&nbsp;&nbsp;&nbsp;&nbsp;
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" data-name="{{Value.RoleName}}" onclick="RoleJS.Delete(this)">删除</a>
                </td>
            </tr>
            {{/each}}
            {{/if}}
        </tbody>
    </table>
</script>

@*详情弹出框*@
<div id="AccountPopUp" class="popup-max" style="width:100%;">
    <div class="popup list" style="width:90%; left:5%; margin-left:0;">
        <p name="AccountTitle">新增用户</p>
        <a class="popup-close" href="javascript:void(0);">关闭</a>
        <lable>
            <input type="hidden" name="AccountID" />
            <input type="hidden" name="Type" />
            <div class="user-detailsinformation">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td rowspan="6" class="user-picture">
                                <div>
                                    <img src="~/Content/IOT/img/user-pic.png" />
                                </div>
                                @*<div class="user-detailsinformation-input">
                                        <input class="btn-primary" type="button" value="更换头像" />
                                    </div>*@
                            </td>
                            <td class="field">用户名:</td>
                            <td><input name="txt_UserNamePop" type="text" value="" /></td>
                            <td class="field">登录密码:</td>
                            <td><input name="txt_PasswordPop" type="password" value="111111" /></td>
                        </tr>
                        <tr>
                            <td class="field">姓名:</td>
                            <td><input name="txt_RealNamePop" type="text" value="" /></td>
                            <td class="field">手机号码:</td>
                            <td><input name="txt_MobilePop" type="text" value="" /></td>
                        </tr>
                        <tr>
                            <td class="field">部门：</td>
                            <td>
                                <select name="select_DepartPop">
                                    @{ 
                                        var Departs = ViewData["Departs"] as List<DataEntity.DataContext.Base_Depart>;
                                        if (Departs != null && Departs.Count > 0)
                                        {
                                            foreach (var depart in Departs)
                                            {
                                                <option value="@depart.ID">@depart.DepartName</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            <td class="field">职位:</td>
                            <td>
                                <select name="select_PositionPop">
                                    @{
                                        var Positions = ViewData["Positions"] as List<DataEntity.DataContext.Base_Position>;
                                        if (Positions != null && Positions.Count > 0)
                                        {
                                            foreach (var position in Positions)
                                            {
                                                <option value="@position.ID">@position.PositionName</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td class="field">工区:</td>
                            <td>
                                <select name="select_StructorPop">
                                    @{
                                        var Structors = ViewData["Structors"] as List<DataEntity.DataContext.Base_Structor>;
                                        if (Structors != null && Structors.Count > 0)
                                        {
                                            foreach (var structor in Structors)
                                            {
                                                <option value="@structor.ID">@structor.StructorName</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                            @*<td class="field">备注:</td>
                                <td>
                                    <input name="Remark" type="text" value="" />
                                </td>*@
                            @*<td class="field">卡号:</td>
                            <td>
                                <input name="RFID" type="text" value="" />
                            </td>*@
                        </tr>
                        <tr>
                            <td class="field">角色分配:</td>
                            <td colspan="3" class="multiselection">
                                <ul name="UL_RolePop">
                                    @{ 
                                        var Roles = ViewData["Roles"] as List<DataEntity.DataContext.Base_Role>;
                                        if (Roles != null && Roles.Count > 0)
                                        {
                                            foreach (var role in Roles)
                                            {
                                                <li><input type="checkbox" value="@role.ID" /><a>@role.RoleName</a></li>
                                            }
                                        }
                                    }
                                </ul>
                            </td>
                        </tr>
                        <tr>
                            <td class="field">订阅提醒:</td>
                            <td colspan="3" class="multiselection">
                                <ul>
                                    <li>
                                        <input type="checkbox" />
                                        <a>无线监测</a>
                                    </li>
                                    <li>
                                        <input type="checkbox" />
                                        <a>龙门吊预警</a>
                                    </li>
                                    <li>
                                        <input type="checkbox" />
                                        <a>检查统计月报</a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="user-detailsinformation-input">
                    <input class="btn-primary" @*data-toggle="modal" data-target="#myModal"*@ type="button" value="保存" onclick="AccountJS.Save();" />
                    <input class="btn-primary" type="button" value="退回" onclick="AccountJS.TurnBack();" />
                </div>
            </div>
        </lable>
    </div>
</div>

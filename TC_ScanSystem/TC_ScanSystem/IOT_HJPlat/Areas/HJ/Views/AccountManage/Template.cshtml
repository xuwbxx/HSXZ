<script type="text/html" id="AccountHtmlTemplate">
    <table class="table table-striped table-normal">
        <thead>
            <tr>
                <th>用户名</th>
                <th>姓名</th>
                <th>手机</th>
                <th>部门</th>
                <th>职位</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            {{if list.length>=0}}
            {{each list as Value}}
            <tr>
                <td>{{Value.UserName}}</td>
                <td>{{Value.RealName}}</td>
                <td>{{Value.Mobile}}</td>
                <td>{{Value.DepartName}}</td>
                <td>{{Value.PositionName}}</td>
                <td>
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" onclick="AccountJS.Edit(this)">编辑</a>&nbsp;&nbsp;&nbsp;&nbsp;
                    <a href="javascript:void(0);" data-id="{{Value.ID}}" data-name="{{Value.RealName}}" onclick="AccountJS.Delete(this)">删除</a>
                </td>
            </tr>
            {{/each}}
            {{/if}}
        </tbody>
    </table>
</script>


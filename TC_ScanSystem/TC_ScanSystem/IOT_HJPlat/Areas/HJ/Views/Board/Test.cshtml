
@{
    ViewBag.Title = "Test";
    Layout = "~/Views/Shared/BoardLayout.cshtml";
}

<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/echarts-stat/ecStat.min.js"></script>
<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/echarts/extension/dataTool.min.js"></script>
<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/echarts/map/js/china.js"></script>
<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/echarts/map/js/world.js"></script>
<script type="text/javascript" src="https://api.map.baidu.com/api?v=2.0&ak=sGQOnNg5djun1fqH5Y1LgISwpd61axAO&__ec_v__=20190126"></script>
<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/echarts/extension/bmap.min.js"></script>
<script type="text/javascript" src="http://echarts.baidu.com/gallery/vendors/simplex.js"></script>

<div style="height:400px;" id="MapContainer"></div>


<script type="text/javascript">

    $(document).ready(function () {
        var dom = document.getElementById("MapContainer");
        var myChart = echarts.init(dom);
        var app = {};
        option = null;
        option = {
            backgroundColor: '#000',
            globe: {
                baseTexture: "https://echarts.baidu.com/examples/data-gl/asset/world.topo.bathy.200401.jpg",
                heightTexture: "https://echarts.baidu.com/examples/data-gl/asset/world.topo.bathy.200401.jpg",
                displacementScale: 0.04,
                shading: 'realistic',
                environment: 'https://echarts.baidu.com/examples/data-gl/asset/starfield.jpg',
                realisticMaterial: {
                    roughness: 0.9
                },
                postEffect: {
                    enable: true
                },
                light: {
                    main: {
                        intensity: 5,
                        shadow: true
                    },
                    ambientCubemap: {
                        texture: 'https://echarts.baidu.com/examples/data-gl/asset/pisa.hdr',
                        diffuseIntensity: 0.2
                    }
                }
            }
        };;
        if (option && typeof option === "object") {
            myChart.setOption(option, true);
        }
    })


</script>
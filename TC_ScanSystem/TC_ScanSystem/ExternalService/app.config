<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="VmsSdkWebServiceSoap11Binding"/>
                <binding name="DataServiceSoap"/>
            </basicHttpBinding>
            <customBinding>
                <binding name="VmsSdkWebServiceSoap12Binding">
                    <textMessageEncoding messageVersion="Soap12"/>
                    <httpTransport/>
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="http://202.127.25.126/services/VmsSdkWebService.VmsSdkWebServiceHttpSoap11Endpoint/" binding="basicHttpBinding" bindingConfiguration="VmsSdkWebServiceSoap11Binding" contract="HikVideoService.VmsSdkWebServicePortType" name="VmsSdkWebServiceHttpSoap11Endpoint"/>
            <endpoint address="http://202.127.25.126/services/VmsSdkWebService.VmsSdkWebServiceHttpSoap12Endpoint/" binding="customBinding" bindingConfiguration="VmsSdkWebServiceSoap12Binding" contract="HikVideoService.VmsSdkWebServicePortType" name="VmsSdkWebServiceHttpSoap12Endpoint"/>
            <endpoint address="http://58.213.214.158:50001/STBMS.DataWebService/DataService.asmx" binding="basicHttpBinding" bindingConfiguration="DataServiceSoap" contract="SafetyKitsService.DataServiceSoap" name="DataServiceSoap"/>
        </client>
    </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>

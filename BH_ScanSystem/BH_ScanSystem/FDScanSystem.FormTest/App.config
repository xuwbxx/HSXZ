<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="YMax" value="10"/>
    <add key="YMin" value="-10"/>
    <add key="ChannelCount" value="8"/>
    <add key="StartChannel" value="0"/>

    <!--设备连接字符串-->
    <add key="Device" value="USB-4716,BID#0"/>


    <!--设备连接字符串-->
    <!--<add key="Device" value="DemoDevice,BID#0"/>-->

    <!--设备采集频率  毫秒-->
    <add key="ScanInterval" value="50"/>

    <!--采集间隔 分钟为单位-->
    <add key="Interval" value="2"/>

    <!-- 采集周期  秒为单位 -->
    <add key="ScanLength" value="60"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>

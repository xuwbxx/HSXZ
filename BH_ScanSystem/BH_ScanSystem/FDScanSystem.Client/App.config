<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
    <section name="TcpTransmit" type="TcpTransmit.Core.Configuration.Client.TcpTransmitSection,TcpTransmit.Core"/>
  </configSections>
  <TcpTransmit SocketBufferSize="4096" MessageBufferSize="8192">
    <Clients>
      <Client Name="Farm">
        <Handler AssemblyName="" ClassName="FDScanSystem.Client.Logic.TcpHandler" Info="测试" Argument=""/>
        <Connectors>
          <Connector Name="connector1" IpAdress="192.168.1.8" Port="50002" ReconnectAttempts="-1" ReconnectAttemptInterval="5000"/>
        </Connectors>
      </Client>
    </Clients>
  </TcpTransmit>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <LockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
      <param name="File" value="log\\trace"/>
      <param name="Encoding" value="gb2312"/>
      <param name="AppendToFile" value="true"/>
      <param name="MaxFileSize" value="10240"/>
      <param name="RollingStyle" value="Date"/>
      <datePattern value="yyyyMMdd'.txt'"/>
      <param name="StaticLogFileName" value="false"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="[%d][%-5p] [%t] %c [%x] - %m%n"/>
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="[%d][%-5p] - %m%n"/>
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="log\"/>
      <!--AppendToFile的意思是:每次重新启动的时候,是否是新开一个文件还是在旧的文件里面打日志-->
      <param name="AppendToFile" value="false"/>
      <!--最多有10个文件,超过十个就在这10个文件中滚动-->
      <param name="MaxSizeRollBackups" value="10"/>
      <param name="MaxFileSize" value="10240"/>
      <param name="StaticLogFileName" value="false"/>
      <param name="DatePattern" value="yyyy-MM-dd&quot;.log&quot;"/>
      <param name="RollingStyle" value="Date"/>
      <!--d:代表日期,精确到微妙,可以省略 ;        l:写日志的文件与事件,并且行代码数也显示,如:_Default.Button1_Click(e:\jobSpace\log4net控件应用入门实例源码\myLog4Test\Default.aspx.cs:21  
      t:当前语句所在的线程ID                  u:代表的是用户:如GT1-YANGJUN\Administrator等 
      c:当前日志对象的名称                    p:代表当前日志对象的优先级别，即DEBUG、INFO、WARN…等 
      m:message即消息                         n:代表换行-->
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%n%d{HH:mm:ss.fff} [%t] %-5p %c%n  %l %n  %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="info"/>
      <!--<appender-ref ref="RollingFileAppender"/>-->
      <appender-ref ref="ConsoleAppender"/>
      <appender-ref ref="RollingLogFileAppender"/>
    </root>
  </log4net>
  <connectionStrings>
    <add name="Client_DataConnection" connectionString="Data Source=10.100.100.96;Initial Catalog=FD_TempData;UserId=sa;password=Gwyjc811128" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ScanDataDir" value="E:\工作\中交\风电监测系统\Source\FDScanSystem\FDScanSystem.Client\ScanData"/>
    <add key="FormTitle" value="FD_ScanClient"/>

    <add key="readtime" value="60000"/>
    <!--TraceEnd-->
    <add key="InitSyncRequestCount" value="1000"/>
    <add key="BalloonTipTimeoutSeconds" value="10"/>
    <add key="DEBUG" value="Gray"/>
    <add key="INFO" value="Blue"/>
    <add key="WARN" value="DarkMagenta"/>
    <add key="ERROR" value="Red"/>
    <add key="FATAL" value="DarkRed"/>
    <add key="SUCCESS" value="Green"/>
    <add key="IsDebug" value="True"/>
    <add key="IsLog" value="True"/>

  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>

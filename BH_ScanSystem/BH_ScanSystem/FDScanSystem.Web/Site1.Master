<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="FDScanSystem.Web.Site1" %>

<%@ Register Src="UC/left.ascx" TagName="left" TagPrefix="uc1" %>
<%@ Register Assembly="DevExpress.Web.v14.1, Version=14.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a"
    Namespace="DevExpress.Web.ASPxLoadingPanel" TagPrefix="dx" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <%--    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />--%>
    <title>海上风电远程无线监测系统</title>
    <link href="/Styles/user.css" rel="Stylesheet" type="text/css" />
    <link href="/Styles/components.css" rel="Stylesheet" type="text/css" />
    <link href="/Styles/frame.css" rel="Stylesheet" type="text/css" />
    <script src="/Scripts/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="/scripts/layer/layer.min.js" type="text/javascript"></script>
    <script src="/Scripts/Utilities.js" type="text/javascript"></script>
    <script src="/Scripts/dialog.js" type="text/javascript"></script>
    <script src="/Scripts/jquery.mousewheel.js" type="text/javascript"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <div class="h-header" region="north">
        <div class="h-logo">
            <a href="#">
                <img src="/images/logo4.png" /></a>
        </div>
        <div class="h-toolbar">
            <a href="#"><i class="h-i-user"></i><span>用户中心</span><b class="h-caret"></b></a>
            <ul>
                <li><span>
                    <asp:Literal ID="ltr_UserName" runat="server"></asp:Literal>
                </span></li>
                <li><a href="javascript:void(0);" onclick="SetPwd();" title="修改密码"><i class="h-i-user"></i><span>修改密码</span></a></li>
                <li>
                    <asp:Literal ID="ltr_EditNotice" runat="server"></asp:Literal>
                </li>
                <%--<li><a href="FD_User_List.aspx" title="用户管理"><i class="h-i-user"></i><span>用户管理</span></a></li>
                <li><a href="MK_Project_List.aspx" title="项目管理"><i class="h-i-tasks"></i><span>项目管理</span></a></li>--%>
                <%--  <%if (CheckRights("MK_User_List.aspx"))
                  {%>
                <li><a href="MK_User_List.aspx" title="用户管理"><i class="h-i-user"></i><span>用户管理</span></a></li>
                <%}%>
                <%if (CheckRights("MK_Project_List.aspx"))
                  {%>
                <li><a href="MK_Project_List.aspx" title="项目管理"><i class="h-i-tasks"></i><span>项目管理</span></a></li>
                <%}%>--%>
                <%-- <%if (CheckAccess())
                  {%>
                <li><a href="MK_Access_List.aspx" title="权限管理"><i class="h-i-adjust"></i>
                    <span>权限管理</span></a></li>
                <%}%>--%>
                <li><a href="/LogOut.aspx" title="退出"><i class="h-i-logout"></i><span>退出</span></a></li>
            </ul>
        </div>
    </div>
    <div class="h-main" region="center">
        <form id="Form1" runat="server">
        <%--        <%if (Show_left())
          {%>
        <uc1:left ID="left1" runat="server" />
        <div class="h-screen layout" fit="true">
            <%}
          else
          {%>
            <div>
                <%}%>--%>
        <uc1:left ID="left1" runat="server" />
        <div class="h-screen layout" fit="true">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        </form>
    </div>
    <dx:ASPxLoadingPanel ID="aspMainLoading" ClientInstanceName="aspxClientLoading" Modal="true"
        Text="数据加载中..." runat="server" Theme="iOS">
    </dx:ASPxLoadingPanel>
    <script type="text/javascript">

        jQuery(function () {

            jQuery("form").submit(function () {
                aspxClientLoading.Show();

            })

        })

        function SetPwd() {
            return openChildDialog('修改密码', '/Sys/Dialog/FD_Pwd_Edit.aspx', 600, 400);
        }

    </script>
</body>
</html>

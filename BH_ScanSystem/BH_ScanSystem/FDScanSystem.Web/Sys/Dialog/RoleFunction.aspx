<%@ Page Title="" Language="C#" MasterPageFile="~/Dialog.Master" AutoEventWireup="true" CodeBehind="RoleFunction.aspx.cs" Inherits="FDScanSystem.Web.Sys.RoleFunction" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">

  <script src="../Scripts/CheckBox.js" type="text/javascript"></script>
    <script language="javascript" type="text/javascript">
        $(
		function () {
		    $("input:checkbox", $("#<%= this.TreeView.ClientID %>")).click(
				function () {
				    $(this).CascadingSelect("<%= this.TreeView.ClientID %>", { key: "title", type: "" });
				});
		});
    </script>

</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">

 <table class="tablist2" width="100%" cellspacing="1" cellpadding="0">
        <tr>
            <td class="td2">
                <asp:TreeView ID="TreeView" runat="server" ShowCheckBoxes="All" Width="162px" AutoGenerateDataBindings="False"
                    ExpandDepth="5" ImageSet="Arrows">
                    <HoverNodeStyle Font-Underline="True" ForeColor="#5555DD" />
                    <NodeStyle Font-Names="Tahoma" Font-Size="10pt" ForeColor="Black" HorizontalPadding="5px"
                        NodeSpacing="0px" VerticalPadding="0px" />
                    <ParentNodeStyle Font-Bold="False" />
                    <SelectedNodeStyle Font-Underline="True" ForeColor="#5555DD" HorizontalPadding="0px"
                        VerticalPadding="0px" />
                </asp:TreeView>
            </td>
        </tr>
        <tr>
            <td class="td2" align="center" style="text-align:center;">
                <asp:Button ID="btnSave" runat="server" OnClick="btnSave_Click" OnClientClick="return confirm('您确定保存吗？');"
                    Text="保存" class="save" onmouseout="this.className='save'" onmouseover="this.className='save_hover'" />
                <%--  <asp:Button ID="btnReturn" runat="server" Text="关闭" OnClick="btnReturn_Click" class="close"
                    onmouseout="this.className='close'" onmouseover="this.className='close_hover'" />--%>
                <asp:Button ID="btnClose" runat="server" Text="关闭" class="close" onmouseout="this.className='close'"
                    onmouseover="this.className='close_hover'" OnClientClick="return closeChildDialog();" />
            </td>
        </tr>
    </table>

</asp:Content>

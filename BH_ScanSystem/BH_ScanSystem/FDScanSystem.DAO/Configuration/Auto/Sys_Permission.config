<?xml version="1.0" encoding="utf-8" ?>
<dataOperations xmlns="http://tmp.org/website/DataOperation"
				xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				xsi:schemaLocation="http://tmp.org/website/DataOperation
				DataOperations.xsd">

  <!--功能管理-->
  <dataCommand name="FD_Function_Add" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	INSERT INTO FD_Function
    (
        FUNCTIONNAME,
        DESCRIPTION,
        LINKURL,
        PARENTID,
        CREATEDATE,
        SORT,
        Code,
        IsMenu
    )
	VALUES
    (
        @FUNCTIONNAME,
        @DESCRIPTION,
        @LINKURL,
        @PARENTID,
        @CREATEDATE,
        @SORT,
        @Code,
        @IsMenu);
        SELECT @PID=@@IDENTITY;
        ]]>
    </commandText>
    <parameters>
      <param name="@FUNCTIONNAME" dbType="String" direction="Input" size="20"/>
      <param name="@DESCRIPTION" dbType="String" direction="Input" size="100"/>
      <param name="@LINKURL" dbType="AnsiString" direction="Input" size="200"/>
      <param name="@PARENTID" dbType="Int32" direction="Input" size="0"/>
      <param name="@CREATEDATE" dbType="DateTime" direction="Input" size="0"/>
      <param name="@SORT" dbType="Decimal" direction="Input" size="0"/>
      <param name="@Code" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@IsMenu" dbType="Boolean" direction="Input" size="0"/>
      <param name="@PID" dbType="Int32" direction="Output" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_View" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	SELECT 
    ID,
    FUNCTIONNAME,
    DESCRIPTION,
    LINKURL,
    PARENTID,
    CREATEDATE,
    SORT,
    Code,
    IsMenu
    FROM FD_Function 
    WHERE 
    ID=@ID]]>
    </commandText>
    <parameters>
      <param name="@ID" dbType="Int32" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_Update"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	UPDATE FD_Function
    SET 
	FUNCTIONNAME=@FUNCTIONNAME,
	DESCRIPTION=@DESCRIPTION,
	LINKURL=@LINKURL,
	PARENTID=@PARENTID,
  SORT=@SORT,
  Code = @Code,
  IsMenu = @IsMenu
    WHERE
    ID=@ID
    ]]>
    </commandText>
    <parameters>
      <param name="@ID" dbType="Int32" direction="Input" size="0"/>
      <param name="@FUNCTIONNAME" dbType="String" direction="Input" size="20"/>
      <param name="@DESCRIPTION" dbType="String" direction="Input" size="100"/>
      <param name="@LINKURL" dbType="AnsiString" direction="Input" size="200"/>
      <param name="@Code" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@PARENTID" dbType="Int32" direction="Input" size="0"/>
      <param name="@SORT" dbType="Decimal" direction="Input" size="0"/>
      <param name="@IsMenu" dbType="Boolean" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_Delete"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	DELETE FROM  FD_Function
	WHERE
    ID=@ID]]>
    </commandText>
    <parameters>
      <param name="@ID" dbType="Decimal" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_RecordCount" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
         select count(*) into @recordCount from FD_Function a where a.FunctionName like @name
      ]]>
    </commandText>
    <parameters>
      <param name="@name" dbType="String" direction="Input" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_ListByPaging" database="HK_Project" commandType="StoredProcedure">
    <commandText>
      <![CDATA[
        UP_FD_Function_ListByPaging
      ]]>
    </commandText>
    <parameters>
      <param name="@name" dbType="String" direction="Input" />
      <param name="@pageSize" dbType="Int32" direction="Input" />
      <param name="@pageIndex" dbType="Int32" direction="Input" />
      <param name="@recordCount" dbType="Int32" direction="Output"  />
    </parameters>
  </dataCommand>


  <dataCommand name="FD_Function_List" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
       SELECT ROW_NUMBER () OVER (ORDER BY 
            A.SORT ASC
        ) RowId,
        A.ID,
        A.FunctionName,
        A.FunctionUrl,
        A.ParentId,
        A.CreateDate,
        A.Sort,
        A.FunctionCode,
        B.FunctionName ParentName
        FROM FD_Function A with(nolock)
        LEFT JOIN FD_Function B ON A.ParentId=B.ID
        WHERE (1=1) 
      ]]>
    </commandText>
    <parameters>

    </parameters>
  </dataCommand>

  <dataCommand name="FD_Function_GetParentFunction" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
      SELECT * FROM FD_Function WHERE  LTRIM(RTRIM(LEN(LINKURL)))<1 and ParentId=0
      ]]>
    </commandText>
  </dataCommand>

  <dataCommand name="FD_Function_GetAllFunction" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
      SELECT * FROM FD_Function
      ]]>
    </commandText>
  </dataCommand>

  <dataCommand name="FD_Function_ListByUserId" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
               SELECT DISTINCT d.* FROM FD_User a 
      INNER JOIN FD_UserRole b on a.ID=b.USERID
      INNER JOIN FD_RoleFunction c on b.ROLEID=c.ROLEID
      INNER JOIN FD_Function d on c.FUNCTIONID=d.ID 
      WHERE a.ID=@USERID ORDER BY d.SORT
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int32" direction="Input" size="0"/>
    </parameters>
  </dataCommand>


  <!--角色管理-->
  <dataCommand name="FD_Role_Add" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	INSERT INTO FD_Role
    (
        ROLENAME,
        DESCRIPTION,
        CREATEDATE
    )
	VALUES
    (
        @ROLENAME,
        @DESCRIPTION,
        @CREATEDATE);
        SELECT @PID=@@IDENTITY;
        ]]>
    </commandText>
    <parameters>
      <param name="@ROLENAME" dbType="String" direction="Input" size="20"/>
      <param name="@DESCRIPTION" dbType="String" direction="Input" size="100"/>
      <param name="@CREATEDATE" dbType="DateTime" direction="Input" size="0"/>
      <param name="@PID" dbType="Int32" direction="Output" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Role_View" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	SELECT 
    ID,
    ROLENAME,
    DESCRIPTION,
    CREATEDATE
    FROM FD_Role 

  </dataCommand>

  <dataCommand name="FD_Role_Update"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	UPDATE FD_Role
    SET 
	ROLENAME=@ROLENAME,
	DESCRIPTION=@DESCRIPTION

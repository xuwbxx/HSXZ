      <param name="@username" dbType="String" direction="Input" />
      <param name="@recordCount" dbType="Int64" direction="Output" />
    </parameters>
  </dataCommand>

  <!--用户角色关系-->
  <dataCommand name="FD_USER_ROLE_Add" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	INSERT INTO FD_UserRole
    (
        USERID,
        ROLEID
    )
	VALUES
    (
        @USERID,
        @ROLEID);
        SELECT @PID=@@IDENTITY;;
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int64" direction="Input" size="0"/>
      <param name="@ROLEID" dbType="Int32" direction="Input" size="0"/>
      <param name="@PID" dbType="Int64" direction="Output" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_ROLE_DeleteByUserId"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	DELETE FROM FD_UserRole
	WHERE USERID=@USERID
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int64" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_ROLE_ListByUserId"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	select a.*,b.ROLENAME FROM FD_UserRole a inner join FD_Role b on a.ROLEID=b.ID
	WHERE a.USERID=@USERID
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int64" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="V_Personinfo_Login"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
      select * from V_PERSONINFO where CODE=@CODE
      ]]>
    </commandText>
    <parameters>
      <param name="@CODE" dbType="String" direction="Input" size="0"/>
    </parameters>
  </dataCommand>
</dataOperations>

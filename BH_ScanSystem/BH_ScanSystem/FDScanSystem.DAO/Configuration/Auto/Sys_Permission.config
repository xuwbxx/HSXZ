    <parameters>
      <param name="@ID" dbType="Int32" direction="Input" size="0"/>
      <param name="@ROLENAME" dbType="String" direction="Input" size="20"/>
      <param name="@DESCRIPTION" dbType="String" direction="Input" size="100"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Role_Delete"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	DELETE FROM  FD_Role
	WHERE
    ID=@ID
      ]]>
    </commandText>
    <parameters>
      <param name="@ID" dbType="Int32" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Role_RecordCount" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
         select count(*) into @recordCount from FD_Role a where a.ROLENAME like @name
      ]]>
    </commandText>
    <parameters>
      <param name="@name" dbType="String" direction="Input" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Role_ListByPaging" database="HK_Project" commandType="StoredProcedure">
    <commandText>
      <![CDATA[
      UP_FD_Role_ListByPaging
      ]]>
    </commandText>
    <parameters>
      <param name="@name" dbType="String" direction="Input" />
      <param name="@pageSize" dbType="Int32" direction="Input" />
      <param name="@pageIndex" dbType="Int32" direction="Input" />
      <param name="@recordCount" dbType="Int32" direction="Output"  />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_Role_GetAllRole" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
      SELECT * FROM FD_Role
      ]]>
    </commandText>
  </dataCommand>

  <dataCommand name="FD_Role_ListByUserId" database="HK_Project" commandType="Text">
    <commandText>
      <![CDATA[
      SELECT a.* FROM FD_Role a inner join FD_User_Role b on a.ID=b.ROLEID where b.USERID=@USERID
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int64" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <!--角色功能关系-->
  <dataCommand name="FD_RoleFunction_Add" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	      INSERT INTO FD_RoleFunction
          (
              RoleId,
              FunctionId
          )
	      VALUES
          (
              @ROLEID,
              @FUNCTIONID);
        SELECT @PID=@@IDENTITY;;
      ]]>
    </commandText>
    <parameters>
      <param name="@ROLEID" dbType="Int32" direction="Input" size="0"/>
      <param name="@FUNCTIONID" dbType="Int32" direction="Input" size="0"/>
      <param name="@PID" dbType="Int32" direction="Output" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_RoleFunction_DeleteByRoleId"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	DELETE FROM FD_RoleFunction
	WHERE ROLEID=@ROLEID
      ]]>
    </commandText>
    <parameters>
      <param name="@ROLEID" dbType="Int32" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_RoleFunction_ListByRoleId"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	select a.*,b.FUNCTIONNAME FROM FD_RoleFunction a inner join FD_Function b on a.FUNCTIONID=b.ID
	WHERE a.ROLEID=@ROLEID
      ]]>
    </commandText>
    <parameters>
      <param name="@ROLEID" dbType="Int32" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_RoleFunction_ListByUserId"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[SELECT c.*,d.FUNCTIONNAME FROM FD_User a 
              INNER JOIN FD_UserRole b on a.ID=b.USERID
              INNER JOIN FD_Role_FUNCTION c on b.ROLEID=c.ROLEID
              INNER JOIN FD_Function d on c.FUNCTIONID=d.ID
	            WHERE a.USERID=@USERID ORDER BY d.SORT
      ]]>
    </commandText>
    <parameters>
      <param name="@USERID" dbType="Int64" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <!--用户管理-->
  <dataCommand name="FD_USER_Add" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	    INSERT INTO OS_Admin_User
        (
            UserName,
            Password,
            RealName,
            Mobile,
            Email,
            Status,
            CreateDate,
            SubsiteProperty,
            IsDelete
        )
	    VALUES
        (
         @UserName,
            @Password,
            @RealName,
            @Mobile,
            @Email,
            0,
            getdate(),
            @SubsiteProperty
            'false'
            );
        SELECT @PID=@@IDENTITY;
       
      ]]>
    </commandText>
    <parameters>
      <param name="@UserName" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@Password" dbType="AnsiString" direction="Input" size="20"/>
      <param name="@RealName" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@Mobile" dbType="AnsiString" direction="Input" size="18"/>
      <param name="@Email" dbType="AnsiString" direction="Input" size="50"/>
      <param name="@SubsiteProperty" dbType="Int64" direction="Input" size="8"/>

      <param name="@PID" dbType="Int32" direction="Output" />
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_View" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	SELECT 
   *
    FROM FD_User with(nolock)
    WHERE 
    ID=@Idx and IsDelete='false'
      ]]>
    </commandText>
    <parameters>
      <param name="@Idx" dbType="Int64" direction="Input" size="8"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_ViewByUserName" database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	SELECT 
    *
    FROM FD_User with(nolock)
    WHERE 
    UserName=@UserName
      ]]>
    </commandText>
    <parameters>
      <param name="@UserName" dbType="String" direction="Input" size="0"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_Update"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	UPDATE OS_Admin_User
    SET 
	UserName=@UserName,
	Password=@Password,
	RealName=@RealName,
	Mobile=@Mobile,
	Email=@Email,
  SubsiteProperty = @SubsiteProperty
    WHERE
    Idx=@Idx
      ]]>
    </commandText>
    <parameters>
      <param name="@Idx" dbType="Int64" direction="Input" size="8"/>
      <param name="@UserName" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@Password" dbType="AnsiString" direction="Input" size="20"/>
      <param name="@RealName" dbType="AnsiString" direction="Input" size="300"/>
      <param name="@Mobile" dbType="AnsiString" direction="Input" size="18"/>
      <param name="@Email" dbType="AnsiString" direction="Input" size="50"/>
      <param name="@SubsiteProperty" dbType="Int64" direction="Input" size="8"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_Delete"  database="HK_Project" commandType="Text" >
    <commandText>
      <![CDATA[
	  DELETE FROM  FD_User
	  WHERE
    ID=@Idx
    ]]>
    </commandText>
    <parameters>
      <param name="@Idx" dbType="Int64" direction="Input" size="8"/>
    </parameters>
  </dataCommand>

  <dataCommand name="FD_USER_ListByPaging" database="HK_Project" commandType="StoredProcedure">
    <commandText>
      <![CDATA[
      UP_TS_User_ListByPaging
      ]]>
    </commandText>
    <parameters>
      <param name="@pageSize" dbType="Decimal" direction="Input" />
      <param name="@pageIndex" dbType="Decimal" direction="Input" />
